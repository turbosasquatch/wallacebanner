{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claire-george-party-uploads",
  "main": "src/index.js",
  "compatibility_date": "2026-07-25",
  "account_id": "d3896db17ee5c7770c6c0c1478a5052a",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "media.streamvaults.co.uk",
      "custom_domain": true
    }
  ],
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "claire-george-party-uploads-2026"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claire-george-gallery-2026",
      "database_id": "32f6d902-cfbb-488a-9c46-034ed9a748db",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ]
}
